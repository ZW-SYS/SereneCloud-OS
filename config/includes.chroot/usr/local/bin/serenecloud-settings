if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setApplicationName("serenecloud-settings")
    app.setDesktopFileName("serenecloud-settings")
    app.setStyleSheet(QSS)
    w = Main()
    w.resize(1100, 720)
    if "--egg" in sys.argv:       # 方便截图测试
        w.show(); w.show_egg()
    else:
        w.showMaximized()
    sys.exit(app.exec())
