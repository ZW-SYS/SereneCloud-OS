#!/bin/sh
# 云安 OS (SereneCloud OS) 的 live-build 配置
set -e
lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --firmware-binary true \
  --firmware-chroot true \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --security true \
  --updates true \
  --apt-recommends true \
  --linux-flavours amd64 \
  --chroot-squashfs-compression-type zstd \
  --iso-application "SereneCloud OS" \
  --iso-publisher "云安 https://github.com/ZW-SYS/SereneCloud-OS" \
  --iso-volume "SereneCloud" \
  --image-name "SereneCloud-OS" \
  --bootappend-live "boot=live components quiet splash locales=zh_CN.UTF-8 keyboard-layouts=us timezone=Asia/Shanghai username=yunan hostname=serenecloud user-fullname=SereneCloud" \
  "${@}"
